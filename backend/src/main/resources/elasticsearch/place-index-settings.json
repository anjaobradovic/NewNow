{
  "index": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "analysis": {
    "char_filter": {
      "cyrillic_to_latin": {
        "type": "mapping",
        "mappings": [
          "А=>A","Б=>B","В=>V","Г=>G","Д=>D","Ђ=>Dj","Е=>E","Ж=>Z","З=>Z","И=>I",
          "Ј=>J","К=>K","Л=>L","Љ=>Lj","М=>M","Н=>N","Њ=>Nj","О=>O","П=>P","Р=>R",
          "С=>S","Т=>T","Ћ=>C","У=>U","Ф=>F","Х=>H","Ц=>C","Ч=>C","Џ=>Dz","Ш=>S",
          "а=>a","б=>b","в=>v","г=>g","д=>d","ђ=>dj","е=>e","ж=>z","з=>z","и=>i",
          "ј=>j","к=>k","л=>l","љ=>lj","м=>m","н=>n","њ=>nj","о=>o","п=>p","р=>r",
          "с=>s","т=>t","ћ=>c","у=>u","ф=>f","х=>h","ц=>c","ч=>c","џ=>dz","ш=>s"
        ]
      }
    },
    "analyzer": {
      "newnow_text": {
        "type": "custom",
        "char_filter": ["cyrillic_to_latin"],
        "tokenizer": "standard",
        "filter": ["lowercase", "asciifolding"]
      }
    },
    "normalizer": {
      "newnow_sortable": {
        "type": "custom",
        "char_filter": ["cyrillic_to_latin"],
        "filter": ["lowercase", "asciifolding"]
      }
    }
  }
}
